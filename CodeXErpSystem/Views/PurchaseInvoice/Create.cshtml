     function updateBalanceDeductionPreview() {
         const pm = document.getElementById('PaymentMethod')?.value;
         const previewBox = document.getElementById('balanceDeductionPreview');
         if (!previewBox) return;

         const statusContainer = document.getElementById('invoiceStatusContainer');
         if (pm === '6' && window.currentSupplierBalance !== undefined) {
             previewBox.style.display = 'block';
             if (statusContainer) statusContainer.style.display = 'none';
             let currentBal = window.currentSupplierBalance || 0;
             let availBal = currentBal < -0.01 ? Math.abs(currentBal) : 0;
             let grandTotal = parseFloat(document.getElementById('invoiceGrandTotal')?.innerText) || 0;

             document.getElementById('previewAvailableBal').innerHTML = `${availBal.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})} ج.م`;

             let deductInput = document.getElementById('deductionAmountInput');
             if (deductInput && (!deductInput.value || parseFloat(deductInput.value) === 0)) {
                 deductInput.value = grandTotal.toFixed(2);
             }
             calculateBalanceDeduction();
         } else {
             previewBox.style.display = 'none';
             if (statusContainer) statusContainer.style.display = 'flex';
         }
     }

     function setFullDeductionAmount() {
         let grandTotal = parseFloat(document.getElementById('invoiceGrandTotal')?.innerText) || 0;
         let deductInput = document.getElementById('deductionAmountInput');
         if (deductInput) {
             deductInput.value = grandTotal.toFixed(2);
             calculateBalanceDeduction();
         }
     }

     function calculateBalanceDeduction() {
         let currentBal = window.currentSupplierBalance || 0;
         let availBal = currentBal < -0.01 ? Math.abs(currentBal) : 0;
         let grandTotal = parseFloat(document.getElementById('invoiceGrandTotal')?.innerText) || 0;
         let deductAmt = parseFloat(document.getElementById('deductionAmountInput')?.value) || 0;

         if (deductAmt > grandTotal && grandTotal > 0) {
             deductAmt = grandTotal;
             document.getElementById('deductionAmountInput').value = grandTotal.toFixed(2);
         }
         if (deductAmt < 0) deductAmt = 0;

         let remBal = availBal - deductAmt;
         let remInv = grandTotal - deductAmt;

         let remBalEl = document.getElementById('previewRemainingBalance');
         if (remBal >= 0) {
             remBalEl.innerHTML = `<span style="color:#059669;">${remBal.toLocaleString('en-US', {minimumFractionDigits: 2})} ج.م (متاح)</span>`;
         } else {
             remBalEl.innerHTML = `<span style="color:#dc2626;">0.00 ج.م <small>(تجاوز المتاح بـ ${Math.abs(remBal).toLocaleString('en-US', {minimumFractionDigits: 2})} ج.م)</small></span>`;
         }

         let remInvEl = document.getElementById('previewRemainingInvoice');
         if (remInv <= 0.01) {
             remInvEl.innerHTML = `<span style="color:#059669;">0.00 ج.م (مغطاة بالكامل)</span>`;
         } else {
             remInvEl.innerHTML = `<span style="color:#dc2626;">${remInv.toLocaleString('en-US', {minimumFractionDigits: 2})} ج.م (غير مسدد)</span>`;
         }

         // Sync form PaidAmount & Status
         let formPaidInput = document.getElementById('hiddenInvoicePaidAmount');
         let formStatusSelect = document.getElementById('hiddenInvoiceStatus');
         if (formPaidInput && formStatusSelect) {
             formPaidInput.value = deductAmt.toFixed(2);
             if (deductAmt >= grandTotal - 0.01 && grandTotal > 0) {
                 formStatusSelect.value = '1';
             } else if (deductAmt > 0) {
                 formStatusSelect.value = '3';
             } else {
                 formStatusSelect.value = '2';
             }
         }
     }

     function formatBalHtml(bal) {
         if (bal > 0.01) {
             return `<span style="color:#dc2626;">${bal.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})} ج.م (مستحق للمورد)</span>`;
         } else if (bal < -0.01) {
             return `<span style="color:#2563eb;">${Math.abs(bal).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})} ج.م (رصيد دائن لك)</span>`;
         } else {
             return `<span style="color:#059669;">0.00 ج.م (خالص)</span>`;
         }
     }

     function validateInvoiceForm() {
         try {
             let supplierEl = document.getElementById('SupplierId');
             if (!supplierEl || !supplierEl.value) {
                 alert('⚠️ يرجى اختيار المورد أولاً');
                 if (supplierEl) supplierEl.focus();
                 return false;
             }
             let warehouseEl = document.getElementById('WarehouseId') || document.querySelector('select[name="WarehouseId"]');
             if (!warehouseEl || !warehouseEl.value) {
                 alert('⚠️ يرجى اختيار المخزن أولاً');
                 if (warehouseEl) warehouseEl.focus();
                 return false;
             }
             let rows = document.querySelectorAll('#lineItemsBody tr');
             if (rows.length === 0) {
                 alert('⚠️ يجب إضافة صنف واحد على الأقل في الفاتورة');
                 return false;
             }
             for (let i = 0; i < rows.length; i++) {
                 let productSel = rows[i].querySelector('.product-select');
                 if (!productSel || !productSel.value) {
                     alert('⚠️ يرجى اختيار الصنف لجميع البنود في الفاتورة');
                     return false;
                 }
                 let qtyInput = rows[i].querySelector('.qty-input');
                 if (!qtyInput || parseFloat(qtyInput.value) <= 0) {
                     alert('⚠️ يرجى إدخال كمية صحيحة أكبر من الصفر');
                     return false;
                 }
             }
             return true;
         } catch(e) {
             alert('خطأ أثناء التحقق من البيانات: ' + e.message);
             return false;
         }
     }

     function selectInvoiceStatus(val) {
         let btns = ['statusBtn1','statusBtn2','statusBtn3'];
         let styles = {
             '1': { bg:'#dcfce7', border:'#22c55e', color:'#166534' },
             '2': { bg:'#fef9c3', border:'#facc15', color:'#854d0e' },
             '3': { bg:'#ede9fe', border:'#8b5cf6', color:'#5b21b6' }
         };
         let labels = { '1':'✅ مدفوعة بالكامل', '2':'⏳ غير مدفوعة (آجل)', '3':'💵 مدفوعة جزئياً' };
         btns.forEach(id => {
             let el = document.getElementById(id);
             if (el) { el.style.background='#f9fafb'; el.style.borderColor='#d1d5db'; el.style.color='#374151'; el.style.boxShadow='none'; }
         });
         let chosen = document.getElementById('statusBtn' + val);
         if (chosen && styles[val]) {
             chosen.style.background = styles[val].bg;
             chosen.style.borderColor = styles[val].border;
             chosen.style.color = styles[val].color;
             chosen.style.boxShadow = '0 2px 8px rgba(0,0,0,0.10)';
         }
         let badge = document.getElementById('statusBadgeDisplay');
         if (badge) badge.innerText = labels[val] || 'لم يتم الاختيار بعد';
         document.getElementById('hiddenInvoiceStatus').value = val;
         onPageStatusChange(val);
     }

     function openInvoiceStatusModal() {
         try {
             if (!validateInvoiceForm()) {
                 return;
             }
             let errEl = document.getElementById('modalStatusError');
             if (errEl) errEl.style.display = 'none';
             const pm = document.getElementById('PaymentMethod')?.value;
             let grandTotal = parseFloat((document.getElementById('invoiceGrandTotal')?.innerText || '0').replace(/,/g, '')) || 0;
             let deductAmt = parseFloat(document.getElementById('deductionAmountInput')?.value) || 0;

             let selectEl = document.getElementById('modalStatusSelect');
             let partBox = document.getElementById('modalPartialPaymentBox');
             let partInput = document.getElementById('modalPaidAmountInput');

             if (pm === '6' && deductAmt > 0) {
                 if (deductAmt >= grandTotal - 0.01 && grandTotal > 0) {
                     if (selectEl) selectEl.value = '1';
                     onModalStatusChange('1');
                 } else {
                     if (selectEl) selectEl.value = '3';
                     if (partInput) partInput.value = deductAmt.toFixed(2);
                     onModalStatusChange('3');
                 }
             } else {
                 if (selectEl) selectEl.value = '';
                 if (partBox) partBox.style.display = 'none';
                 if (partInput) partInput.value = '';
             }
             let modalEl = document.getElementById('invoiceStatusModal');
             if (!modalEl) {
                 alert('⚠️ خطأ: شاشة اختيار حالة الفاتورة غير موجودة في الصفحة');
                 return;
             }
             modalEl.style.display = 'flex';
             modalEl.style.setProperty('display', 'flex', 'important');
         } catch(err) {
             alert('حدث خطأ أثناء فتح شاشة اختيار الحالة: ' + err.message);
             console.error(err);
         }
     }

     function closeInvoiceStatusModal() {
         let modalEl = document.getElementById('invoiceStatusModal');
         if (modalEl) modalEl.style.display = 'none';
     }

     function onModalStatusChange(val) {
         let errEl = document.getElementById('modalStatusError');
         if (errEl) errEl.style.display = 'none';
         let partBox = document.getElementById('modalPartialPaymentBox');
         let partInput = document.getElementById('modalPaidAmountInput');
         if (val === '3') {
             if (partBox) partBox.style.display = 'block';
             let grandTotal = parseFloat((document.getElementById('invoiceGrandTotal')?.innerText || '0').replace(/,/g, '')) || 0;
             let amt = parseFloat(partInput?.value) || 0;
             let rem = grandTotal - amt;
             let totalEl = document.getElementById('modalDisplayTotalAmount');
             let remEl = document.getElementById('modalDisplayRemainingAmount');
             if (totalEl) totalEl.innerText = grandTotal.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
             if (remEl) remEl.innerText = (rem >= 0 ? rem : 0).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
             if (partInput) partInput.focus();
         } else {
             if (partBox) partBox.style.display = 'none';
         }
     }

     function onPageStatusChange(val) {
         let grandTotal = parseFloat((document.getElementById('invoiceGrandTotal')?.innerText || '0').replace(/,/g, '')) || 0;
         let statusHidden = document.getElementById('hiddenInvoiceStatus');
         let paidHidden = document.getElementById('hiddenInvoicePaidAmount');
         let displayTotal = document.getElementById('onpageDisplayTotal');
         let displayRem = document.getElementById('onpageDisplayRemaining');
         let errEl = document.getElementById('onpagePaidAmountError');
         let autoEl = document.getElementById('onpageAutoPaidAlert');
         let partBox = document.getElementById('onpagePartialPaymentBox');
         let paidInput = document.getElementById('onpagePaidAmountInput');
         let saveBtn = document.getElementById('saveInvoiceBtn');

         if (statusHidden) statusHidden.value = val;
         if (displayTotal) displayTotal.innerText = grandTotal.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});

         if (val === '3') { // 3 = مدفوعة جزئياً / دفعة مؤقتة
             if (partBox) partBox.style.display = 'block';
             if (paidInput) paidInput.value = '';
             if (displayRem) displayRem.innerText = grandTotal.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
             if (errEl) errEl.style.display = 'none';
             if (autoEl) autoEl.style.display = 'none';
             if (saveBtn) saveBtn.disabled = false;
         } else {
             if (partBox) partBox.style.display = 'none';
             if (errEl) errEl.style.display = 'none';
             if (autoEl) autoEl.style.display = 'none';
             if (saveBtn) saveBtn.disabled = false;
             if (val === '1') {
                 if (paidHidden) paidHidden.value = grandTotal.toFixed(2);
             } else {
                 if (paidHidden) paidHidden.value = '0.00';
             }
         }
     }

     function onPagePaidAmountInput(val) {
         let grandTotal = parseFloat((document.getElementById('invoiceGrandTotal')?.innerText || '0').replace(/,/g, '')) || 0;
         let paidVal = parseFloat(val) || 0;
         let rem = grandTotal - paidVal;
         let displayTotal = document.getElementById('onpageDisplayTotal');
         let displayRem = document.getElementById('onpageDisplayRemaining');
         let errEl = document.getElementById('onpagePaidAmountError');
         let autoEl = document.getElementById('onpageAutoPaidAlert');
         let saveBtn = document.getElementById('saveInvoiceBtn');
         let statusHidden = document.getElementById('hiddenInvoiceStatus');
         let paidHidden = document.getElementById('hiddenInvoicePaidAmount');

         if (displayTotal) displayTotal.innerText = grandTotal.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});

         // Rule 1: PaidAmount > GrandTotal -> ERROR and prevent save!
         if (paidVal > grandTotal + 0.005 && grandTotal > 0) {
             if (displayRem) displayRem.innerText = '0.00';
             if (errEl) errEl.style.display = 'block';
             if (autoEl) autoEl.style.display = 'none';
             if (saveBtn) {
                 saveBtn.disabled = true;
                 saveBtn.style.opacity = '0.5';
             }
             if (paidHidden) paidHidden.value = paidVal.toFixed(2);
             return;
         } else {
             if (errEl) errEl.style.display = 'none';
             if (saveBtn) {
                 saveBtn.disabled = false;
                 saveBtn.style.opacity = '1';
             }
         }

         // Rule 2: PaidAmount == GrandTotal -> Convert to status 1 (مدفوعة بالكامل) automatically!
         if (Math.abs(paidVal - grandTotal) <= 0.005 && grandTotal > 0) {
             if (displayRem) displayRem.innerText = '0.00';
             if (autoEl) autoEl.style.display = 'block';
             selectInvoiceStatus('1');
             if (paidHidden) paidHidden.value = grandTotal.toFixed(2);
             return;
         } else {
             if (autoEl) autoEl.style.display = 'none';
             if (statusHidden) statusHidden.value = '3';
         }

         // Normal partial
         if (rem < 0) rem = 0;
         if (displayRem) displayRem.innerText = rem.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
         if (paidHidden) paidHidden.value = paidVal.toFixed(2);
     }

     function handleSaveInvoiceClick() {
         try {
             if (!validateInvoiceForm()) {
                 return;
             }
             let onpageSel = document.getElementById('hiddenInvoiceStatus')?.value;
             let grandTotal = parseFloat((document.getElementById('invoiceGrandTotal')?.innerText || '0').replace(/,/g, '')) || 0;
             let paidVal = parseFloat(document.getElementById('onpagePaidAmountInput')?.value) || 0;

             // 1) If user has not chosen status on page, open the modal so they choose it!
             if (!onpageSel) {
                 openInvoiceStatusModal();
                 return;
             }

             // 2) If status is 3 (partial) and paidVal > grandTotal: block and alert!
             if (onpageSel === '3' && paidVal > grandTotal + 0.005) {
                 alert('⚠️ المبلغ المدفوع أكبر من إجمالي الفاتورة! لا يمكن إدخال مبلغ أكبر من الإجمالي ولا يمكن حفظ الفاتورة.');
                 document.getElementById('onpagePaidAmountInput')?.focus();
                 return;
             }

             // 3) If status is 3 (partial) and paidVal == grandTotal: convert to 1 (fully paid)!
             if (onpageSel === '3' && Math.abs(paidVal - grandTotal) <= 0.005 && grandTotal > 0) {
                 onpageSel = '1';
                 paidVal = grandTotal;
                 let selEl = document.getElementById('onpageInvoiceStatus');
                 if (selEl) selEl.value = '1';
             }

             // 4) If status is 3 (partial) and paidVal <= 0: alert!
             if (onpageSel === '3' && (paidVal <= 0 || isNaN(paidVal))) {
                 alert('⚠️ يرجى إدخال المبلغ المدفوع جزئياً / مؤقتاً بحيث يكون أكبر من الصفر وأقل من إجمالي الفاتورة.');
                 document.getElementById('onpagePaidAmountInput')?.focus();
                 return;
             }

             let statusHidden = document.getElementById('hiddenInvoiceStatus');
             let paidHidden = document.getElementById('hiddenInvoicePaidAmount');
             if (statusHidden) statusHidden.value = onpageSel;
             if (paidHidden) paidHidden.value = (onpageSel === '1' ? grandTotal : (onpageSel === '3' ? paidVal : 0)).toFixed(2);

             let frm = document.getElementById('invoiceForm');
             if (frm) {
                 frm.submit();
             } else {
                 alert('خطأ: نموذج الفاتورة غير موجود');
             }
         } catch(e) {
             alert('حدث خطأ أثناء محاولة حفظ الفاتورة: ' + e.message);
             console.error(e);
         }
     }

     function onModalPaidAmountInput(val) {
          let errEl = document.getElementById('modalStatusError');
          let grandTotal = parseFloat((document.getElementById('invoiceGrandTotal')?.innerText || '0').replace(/,/g, '')) || 0;
          let amt = parseFloat(val) || 0;
          let rem = grandTotal - amt;
          let totalEl = document.getElementById('modalDisplayTotalAmount');
          let remEl = document.getElementById('modalDisplayRemainingAmount');
          if (totalEl) totalEl.innerText = grandTotal.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
          if (remEl) remEl.innerText = (rem >= 0 ? rem : 0).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});

          if (amt > grandTotal + 0.005 && grandTotal > 0) {
              if (errEl) {
                  errEl.innerHTML = '<i class="fas fa-exclamation-triangle me-1"></i> المبلغ المدخل أكبر من إجمالي الفاتورة، لا يمكن حفظ الفاتورة!';
                  errEl.style.display = 'block';
                  errEl.style.background = '#fef2f2';
                  errEl.style.borderColor = '#f87171';
                  errEl.style.color = '#b91c1c';
              }
          } else if (Math.abs(amt - grandTotal) <= 0.005 && grandTotal > 0) {
              let selEl = document.getElementById('modalStatusSelect');
              if (selEl) selEl.value = '1';
              if (errEl) {
                  errEl.innerHTML = '<i class="fas fa-check-circle me-1"></i> المبلغ المدخل يساوي الإجمالي، تم تحويل حالة الفاتورة تلقائياً إلى (مدفوعة بالكامل)';
                  errEl.style.display = 'block';
                  errEl.style.background = '#ecfdf5';
                  errEl.style.borderColor = '#10b981';
                  errEl.style.color = '#065f46';
              }
          } else if (errEl && errEl.style.display === 'block') {
              errEl.style.display = 'none';
          }
      }

      function confirmAndSubmitInvoice() {
          try {
              let statusVal = document.getElementById('modalStatusSelect')?.value;
              let errDiv = document.getElementById('modalStatusError');
              if (!statusVal) {
                  if (errDiv) {
                      errDiv.innerHTML = '<i class="fas fa-exclamation-triangle me-1"></i> يرجى اختيار حالة الفاتورة أولاً ولا يمكن تخطي هذه الخطوة!';
                      errDiv.style.display = 'block';
                  } else {
                      alert('يرجى اختيار حالة الفاتورة أولاً ولا يمكن تخطي هذه الخطوة!');
                  }
                  return;
              }
              let paidVal = 0;
              let grandTotal = parseFloat((document.getElementById('invoiceGrandTotal')?.innerText || '0').replace(/,/g, '')) || 0;
              if (statusVal === '3') {
                  paidVal = parseFloat(document.getElementById('modalPaidAmountInput')?.value) || 0;
                  if (paidVal <= 0) {
                      if (errDiv) {
                          errDiv.innerHTML = '<i class="fas fa-exclamation-triangle me-1"></i> يرجى إدخال المبلغ المدفوع جزئياً بشكل صحيح أكبر من الصفر!';
                          errDiv.style.display = 'block';
                      } else {
                          alert('يرجى إدخال المبلغ المدفوع جزئياً بشكل صحيح أكبر من الصفر!');
                      }
                      return;
                  }
                  if (paidVal > grandTotal + 0.005) {
                      if (errDiv) {
                          errDiv.innerHTML = '<i class="fas fa-exclamation-triangle me-1"></i> المبلغ المدخل أكبر من إجمالي الفاتورة، لا يمكن حفظ الفاتورة!';
                          errDiv.style.display = 'block';
                      } else {
                          alert('المبلغ المدخل أكبر من إجمالي الفاتورة، لا يمكن حفظ الفاتورة!');
                      }
                      return;
                  }
                  if (Math.abs(paidVal - grandTotal) <= 0.005) {
                      statusVal = '1';
                      paidVal = grandTotal;
                      let selEl = document.getElementById('modalStatusSelect');
                      if (selEl) selEl.value = '1';
                  }
              } else if (statusVal === '1') {
                  paidVal = grandTotal;
              } else {
                  paidVal = 0;
              }

              let statusHidden = document.getElementById('hiddenInvoiceStatus');
              let paidHidden = document.getElementById('hiddenInvoicePaidAmount');
              if (statusHidden) statusHidden.value = statusVal;
              if (paidHidden) paidHidden.value = paidVal.toFixed(2);
              
              let frm = document.getElementById('invoiceForm');
              if (frm) {
                  frm.submit();
              } else {
                  alert('خطأ: نموذج الفاتورة غير موجود');
              }
          } catch(err) {
              alert('حدث خطأ أثناء حفظ الفاتورة: ' + err.message);
              console.error(err);
          }
      }
</script>







                         document.getElementById('supplierDebtsVal').innerHTML = `<span style="color:#dc2626;">${debts.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})} ج.م ${debts > 0 ? '(مستحق للمورد)' : ''}</span>`;

    function updateBalanceDeductionPreview() {
        const pm = document.getElementById('PaymentMethod')?.value;
        const previewBox = document.getElementById('balanceDeductionPreview');
        if (!previewBox) return;

        if (pm === '6' && window.currentSupplierBalance !== undefined) {
            previewBox.style.display = 'block';
            let currentBal = window.currentSupplierBalance || 0;
            let availBal = currentBal < -0.01 ? Math.abs(currentBal) : 0;
            let grandTotal = parseFloat(document.getElementById('invoiceGrandTotal')?.innerText) || 0;

            document.getElementById('previewAvailableBal').innerHTML = `${availBal.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})} ج.م`;

            let deductInput = document.getElementById('deductionAmountInput');
            if (deductInput && (!deductInput.value || parseFloat(deductInput.value) === 0)) {
                deductInput.value = grandTotal.toFixed(2);
            }
            calculateBalanceDeduction();
        } else {
            previewBox.style.display = 'none';
        }
    }

    function setFullDeductionAmount() {
        let grandTotal = parseFloat(document.getElementById('invoiceGrandTotal')?.innerText) || 0;
        let deductInput = document.getElementById('deductionAmountInput');
        if (deductInput) {
            deductInput.value = grandTotal.toFixed(2);
            calculateBalanceDeduction();
        }
    }

    function calculateBalanceDeduction() {
        let currentBal = window.currentSupplierBalance || 0;
        let availBal = currentBal < -0.01 ? Math.abs(currentBal) : 0;
        let grandTotal = parseFloat(document.getElementById('invoiceGrandTotal')?.innerText) || 0;
        let deductAmt = parseFloat(document.getElementById('deductionAmountInput')?.value) || 0;

        if (deductAmt > grandTotal && grandTotal > 0) {
            deductAmt = grandTotal;
            document.getElementById('deductionAmountInput').value = grandTotal.toFixed(2);
        }
        if (deductAmt < 0) deductAmt = 0;

        let remBal = availBal - deductAmt;
        let remInv = grandTotal - deductAmt;

        let remBalEl = document.getElementById('previewRemainingBalance');
        if (remBal >= 0) {
            remBalEl.innerHTML = `<span style="color:#059669;">${remBal.toLocaleString('en-US', {minimumFractionDigits: 2})} ج.م (متاح)</span>`;
        } else {
            remBalEl.innerHTML = `<span style="color:#dc2626;">0.00 ج.م <small>(تجاوز المتاح بـ ${Math.abs(remBal).toLocaleString('en-US', {minimumFractionDigits: 2})} ج.م)</small></span>`;
        }

        let remInvEl = document.getElementById('previewRemainingInvoice');
        if (remInv <= 0.01) {
            remInvEl.innerHTML = `<span style="color:#059669;">0.00 ج.م (مغطاة بالكامل)</span>`;
        } else {
            remInvEl.innerHTML = `<span style="color:#dc2626;">${remInv.toLocaleString('en-US', {minimumFractionDigits: 2})} ج.م (غير مسدد)</span>`;
        }
    }


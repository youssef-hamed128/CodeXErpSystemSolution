            return `<span style="color:#dc2626;">${bal.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})} ج.م (مستحق للمورد)</span>`;
        } else if (bal < -0.01) {
            return `<span style="color:#2563eb;">${Math.abs(bal).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})} ج.م (رصيد دائن لك)</span>`;
        } else {
            return `<span style="color:#059669;">0.00 ج.م (خالص)</span>`;
    function validateReturnQty(inputEl, idx) {
        let maxQty = parseFloat(inputEl.getAttribute('data-max-qty'));
        let currentQty = parseFloat(inputEl.value) || 0;
        if (!isNaN(maxQty) && currentQty > maxQty) {
            showToast(`⚠️ الكمية المدخلة (${currentQty}) أكبر من المتبقية للاسترجاع (${maxQty}) في الفاتورة الأصلية!`, 'error');
            inputEl.value = maxQty;
        }
    }

    function selectInvoiceStatus(val) {
        let btn1 = document.getElementById('statusBtn1');
        let btn2 = document.getElementById('statusBtn2');
        let btn3 = document.getElementById('statusBtn3');
        let badge = document.getElementById('statusBadgeDisplay');
        let partBox = document.getElementById('onpagePartialPaymentBox');
        let statusHidden = document.getElementById('hiddenInvoiceStatus');
        let paidHidden = document.getElementById('hiddenInvoicePaidAmount');
        let grandTotal = parseFloat((document.getElementById('invoiceGrandTotal')?.innerText || '0').replace(/,/g, '')) || 0;

        // Reset button styles
        [btn1, btn2, btn3].forEach(b => {
            if(b) {
                b.style.border = '2px solid #d1d5db';
                b.style.background = '#f9fafb';
                b.style.transform = 'scale(1)';
                b.style.boxShadow = 'none';
            }
        });

        if (val === '1' && btn1) {
            btn1.style.border = '2px solid #10b981';
            btn1.style.background = '#ecfdf5';
            btn1.style.transform = 'scale(1.02)';
            btn1.style.boxShadow = '0 4px 12px rgba(16,185,129,0.2)';
            if(badge) {
                badge.innerText = 'مدفوعة بالكامل';
                badge.style.background = '#10b981';
            }
        } else if (val === '2' && btn2) {
            btn2.style.border = '2px solid #f59e0b';
            btn2.style.background = '#fffbeb';
            btn2.style.transform = 'scale(1.02)';
            btn2.style.boxShadow = '0 4px 12px rgba(245,158,11,0.2)';
            if(badge) {
                badge.innerText = 'غير مدفوعة (آجل)';
                badge.style.background = '#f59e0b';
            }
        } else if (val === '3' && btn3) {
            btn3.style.border = '2px solid #8b5cf6';
            btn3.style.background = '#f5f3ff';
            btn3.style.transform = 'scale(1.02)';
            btn3.style.boxShadow = '0 4px 12px rgba(139,92,246,0.2)';
            if(badge) {
                badge.innerText = 'مدفوعة جزئياً';
                badge.style.background = '#8b5cf6';
            }
        }

        let errEl = document.getElementById('onpagePaidAmountError');
        let autoEl = document.getElementById('onpageAutoPaidAlert');
        let saveBtn = document.getElementById('saveInvoiceBtn');
        let displayTotal = document.getElementById('onpageDisplayTotal');
        let displayRem = document.getElementById('onpageDisplayRemaining');
        let paidInput = document.getElementById('onpagePaidAmountInput');

        if (statusHidden) statusHidden.value = val;

        if (val === '3') {
            if (partBox) partBox.style.display = 'block';
            let paidVal = parseFloat(paidInput?.value) || 0;
            let rem = grandTotal - paidVal;
            if (displayTotal) displayTotal.innerText = grandTotal.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            if (paidVal > grandTotal + 0.005 && grandTotal > 0) {
                if (displayRem) displayRem.innerText = '0.00';
                if (errEl) errEl.style.display = 'block';
                if (saveBtn) saveBtn.disabled = true;
                if (paidHidden) paidHidden.value = paidVal.toFixed(2);
                return;
            } else {
                if (errEl) errEl.style.display = 'none';
                if (saveBtn) saveBtn.disabled = false;
                if (paidHidden) paidHidden.value = paidVal.toFixed(2);
            }
            if (rem < 0) rem = 0;
            if (displayRem) displayRem.innerText = rem.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
        } else {
            if (partBox) partBox.style.display = 'none';
            if (errEl) errEl.style.display = 'none';
            if (autoEl) autoEl.style.display = 'none';
            if (saveBtn) saveBtn.disabled = false;
            if (val === '1') {
                if (paidHidden) paidHidden.value = grandTotal.toFixed(2);
            } else {
                if (paidHidden) paidHidden.value = '0.00';
            }
        }
    }

    function onPagePaidAmountInput(val) {
        let grandTotal = parseFloat((document.getElementById('invoiceGrandTotal')?.innerText || '0').replace(/,/g, '')) || 0;
        let paidVal = parseFloat(val) || 0;
        let rem = grandTotal - paidVal;
        let displayTotal = document.getElementById('onpageDisplayTotal');
        let displayRem = document.getElementById('onpageDisplayRemaining');
        let errEl = document.getElementById('onpagePaidAmountError');
        let autoEl = document.getElementById('onpageAutoPaidAlert');
        let saveBtn = document.getElementById('saveInvoiceBtn');
        let statusHidden = document.getElementById('hiddenInvoiceStatus');
        let paidHidden = document.getElementById('hiddenInvoicePaidAmount');

        if (displayTotal) displayTotal.innerText = grandTotal.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});

        if (paidVal > grandTotal + 0.005 && grandTotal > 0) {
            if (displayRem) displayRem.innerText = '0.00';
            if (errEl) errEl.style.display = 'block';
            if (autoEl) autoEl.style.display = 'none';
            if (saveBtn) saveBtn.disabled = true;
            if (paidHidden) paidHidden.value = paidVal.toFixed(2);
            return;
        } else {
            if (errEl) errEl.style.display = 'none';
            if (saveBtn) saveBtn.disabled = false;
        }

        if (Math.abs(paidVal - grandTotal) <= 0.005 && grandTotal > 0) {
            if (displayRem) displayRem.innerText = '0.00';
            if (autoEl) autoEl.style.display = 'block';
            selectInvoiceStatus('1');
            if (paidHidden) paidHidden.value = grandTotal.toFixed(2);
            return;
        } else {
            if (autoEl) autoEl.style.display = 'none';
            if (statusHidden) statusHidden.value = '3';
        }

        if (rem < 0) rem = 0;
        if (displayRem) displayRem.innerText = rem.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
        if (paidHidden) paidHidden.value = paidVal.toFixed(2);
    }

    function handleSaveInvoiceClick() {
        try {
            let onpageSel = document.getElementById('hiddenInvoiceStatus')?.value;
            let grandTotal = parseFloat((document.getElementById('invoiceGrandTotal')?.innerText || '0').replace(/,/g, '')) || 0;
            let paidVal = parseFloat(document.getElementById('onpagePaidAmountInput')?.value) || 0;

            if (!onpageSel) {
                alert('⚠️ يرجى اختيار حالة سداد المرتجع أولاً (مدفوعة بالكامل / آجل / مدفوعة جزئياً) قبل الحفظ');
                document.getElementById('statusBtn1')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }

            if (onpageSel === '3' && paidVal > grandTotal + 0.005) {
                alert('⚠️ المبلغ المدفوع أكبر من إجمالي المرتجع! لا يمكن إدخال مبلغ أكبر من الإجمالي.');
                document.getElementById('onpagePaidAmountInput')?.focus();
                return;
            }

            if (onpageSel === '3' && Math.abs(paidVal - grandTotal) <= 0.005 && grandTotal > 0) {
                onpageSel = '1';
                paidVal = grandTotal;
            }

            if (onpageSel === '3' && (paidVal <= 0 || isNaN(paidVal))) {
                alert('⚠️ يرجى إدخال المبلغ المدفوع جزئياً بحيث يكون أكبر من الصفر وأقل من إجمالي المرتجع.');
                document.getElementById('onpagePaidAmountInput')?.focus();
                return;
            }

            let statusHidden = document.getElementById('hiddenInvoiceStatus');
            let paidHidden = document.getElementById('hiddenInvoicePaidAmount');
            if (statusHidden) statusHidden.value = onpageSel;
            if (paidHidden) paidHidden.value = (onpageSel === '1' ? grandTotal : (onpageSel === '3' ? paidVal : 0)).toFixed(2);

            document.getElementById('invoiceForm').submit();
        } catch (e) {
            console.error(e);
            document.getElementById('invoiceForm').submit();
        }
    }
</script>

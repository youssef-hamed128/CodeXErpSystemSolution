@model CodeXErpSystem.BLL.ViewModels.Payments.PaymentViewModel
@{
    Layout = null;
    string voucherType = "سند مالي";
    string partyTitle = "الطرف المستفيد / الدافع";
    string partyName = "عام / غير محدد";

    if (!string.IsNullOrEmpty(Model.CustomerName))
    {
        voucherType = "سند قبض (استلام من عميل)";
        partyTitle = "اسم العميل";
        partyName = Model.CustomerName;
    }
    else if (!string.IsNullOrEmpty(Model.SupplierName))
    {
        voucherType = "سند صرف (دفع لمورد)";
        partyTitle = "اسم المورد";
        partyName = Model.SupplierName;
    }

    string paymentMethodDisplay = Model.PaymentMethod switch
    {
        CodeXErpSystem.DAL.Entites.Enums.PaymentMethod.Cash => "نقدي (Cash)",
        CodeXErpSystem.DAL.Entites.Enums.PaymentMethod.Credit => "آجل (ذمم)",
        CodeXErpSystem.DAL.Entites.Enums.PaymentMethod.BankTransfer => "تحويل بنكي (Bank Transfer)",
        CodeXErpSystem.DAL.Entites.Enums.PaymentMethod.CreaditCard => "بطاقة ائتمان (Credit Card)",
        CodeXErpSystem.DAL.Entites.Enums.PaymentMethod.Check => "شيك (Check)",
        _ => Model.PaymentMethod.ToString()
    };
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>طباعة السند #@Model.ReceiptNumber - CodeX ERP</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        :root {
            --primary: #1e293b;
            --accent: #2563eb;
            --border: #e2e8f0;
            --bg: #f8fafc;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #e2e8f0;
            margin: 0;
            padding: 20px;
            color: #1e293b;
        }
        .voucher-container {
            max-width: 800px;
            margin: 20px auto;
            background: #fff;
            padding: 40px;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            border: 1px solid #cbd5e1;
            position: relative;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid var(--border);
            padding-bottom: 20px;
            margin-bottom: 30px;
        }
        .header-title h1 {
            margin: 0 0 5px 0;
            font-size: 26px;
            color: var(--accent);
        }
        .header-title p {
            margin: 0;
            font-size: 14px;
            color: #64748b;
        }
        .voucher-badge {
            background: #f1f5f9;
            border: 2px solid var(--accent);
            color: var(--accent);
            padding: 10px 20px;
            border-radius: 12px;
            text-align: center;
        }
        .voucher-badge h2 {
            margin: 0;
            font-size: 18px;
            font-weight: 800;
        }
        .voucher-badge span {
            font-size: 13px;
            color: #475569;
        }
        .voucher-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }
        .info-box {
            background: var(--bg);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 15px 20px;
        }
        .info-box label {
            display: block;
            font-size: 13px;
            color: #64748b;
            margin-bottom: 5px;
            font-weight: 600;
        }
        .info-box .value {
            font-size: 16px;
            font-weight: 700;
            color: #0f172a;
        }
        .amount-box {
            grid-column: span 2;
            background: linear-gradient(135deg, #f0fdf4, #dcfce7);
            border: 1px solid #bbf7d0;
            padding: 20px;
            border-radius: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .amount-box label {
            font-size: 15px;
            color: #166534;
            font-weight: 700;
            margin: 0;
        }
        .amount-box .amount-val {
            font-size: 28px;
            font-weight: 900;
            color: #15803d;
        }
        .notes-box {
            grid-column: span 2;
            background: #fff;
            border: 1px dashed #94a3b8;
            padding: 15px 20px;
            border-radius: 10px;
        }
        .signatures {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 20px;
            margin-top: 50px;
            padding-top: 30px;
            border-top: 1px solid var(--border);
            text-align: center;
        }
        .sig-block {
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .sig-block span {
            font-size: 14px;
            font-weight: 700;
            color: #475569;
            margin-bottom: 40px;
        }
        .sig-line {
            width: 80%;
            border-bottom: 1px solid #94a3b8;
        }
        .footer-note {
            margin-top: 30px;
            text-align: center;
            font-size: 12px;
            color: #94a3b8;
        }
        .print-btn {
            display: block;
            width: 220px;
            margin: 20px auto;
            padding: 12px 24px;
            background: var(--accent);
            color: #fff;
            text-align: center;
            border: none;
            border-radius: 8px;
            font-family: inherit;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 4px 6px rgba(37,99,235,0.2);
            text-decoration: none;
        }
        .print-btn:hover {
            background: #1d4ed8;
        }
        @@media print {
            body {
                background: #fff;
                padding: 0;
            }
            .voucher-container {
                box-shadow: none;
                border: none;
                padding: 10px;
                margin: 0;
                max-width: 100%;
            }
            .print-btn {
                display: none;
            }
        }
    </style>
</head>
<body>

    <button class="print-btn" onclick="window.print()"><i class="fas fa-print"></i> طباعة السند الآن</button>

    <div class="voucher-container">
        <div class="header">
            <div class="header-title">
                <h1>نظام CodeX ERP لإدارة الموارد</h1>
                <p>إيصال سند رسمي معتمد</p>
            </div>
            <div class="voucher-badge">
                <h2>@voucherType</h2>
                <span>رقم السند: <strong>#@Model.ReceiptNumber</strong></span>
            </div>
        </div>

        <div class="voucher-grid">
            <div class="info-box">
                <label><i class="far fa-calendar-alt"></i> تاريخ السند</label>
                <div class="value">@Model.Date.ToString("yyyy-MM-dd")</div>
            </div>

            <div class="info-box">
                <label><i class="fas fa-wallet"></i> طريقة الدفع</label>
                <div class="value">@paymentMethodDisplay</div>
            </div>

            <div class="info-box">
                <label><i class="fas fa-user-tie"></i> @partyTitle</label>
                <div class="value">@partyName</div>
            </div>

            <div class="info-box">
                <label><i class="fas fa-file-invoice"></i> مرتبط بفاتورة</label>
                <div class="value">
                    @(string.IsNullOrEmpty(Model.InvoiceNumber) ? "سند مستقل / عام" : $"# {Model.InvoiceNumber}")
                </div>
            </div>

            <div class="amount-box">
                <label><i class="fas fa-money-bill-wave"></i> إجمالي قيمة السند:</label>
                <div class="amount-val">@Model.Amount.ToString("N2") <small style="font-size:16px;">ج.م</small></div>
            </div>

            <div class="notes-box">
                <label style="color:#64748b; font-size:13px; font-weight:700; display:block; margin-bottom:6px;">
                    <i class="fas fa-sticky-note"></i> الوصف / الملاحظات:
                </label>
                <div style="font-size:15px; color:#1e293b; font-weight:600; line-height: 1.6;">
                    @(string.IsNullOrWhiteSpace(Model.Reference) ? "لا توجد ملاحظات إضافية" : Model.Reference)
                </div>
            </div>
        </div>

        <div class="signatures">
            <div class="sig-block">
                <span>المحاسب المسؤول</span>
                <div class="sig-line"></div>
            </div>
            <div class="sig-block">
                <span>توقيع المستلم</span>
                <div class="sig-line"></div>
            </div>
            <div class="sig-block">
                <span>المدير المالي / الاعتماد</span>
                <div class="sig-line"></div>
            </div>
        </div>

        <div class="footer-note">
            تم إصدار هذا السند آلياً من نظام CodeX ERP - حفظ الحقوق المالية والقانونية.
        </div>
    </div>

</body>
</html>
